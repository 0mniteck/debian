[submodule "debian-slim"]
	path = debian-slim
	url = git@Debian:0mniteck/Debian.git
	branch = debian-slim
[submodule "debian"]
	path = debian
	url = git@Debian:0mniteck/Debian.git
	branch = debian
[submodule "debian-extra"]
	path = debian-extra
	url = git@Debian:0mniteck/Debian.git
	branch = debian-extra
[submodule ".pki"]
	path = .pki
	url = git@.pki:0mniteck/.pki.git
	branch = main
